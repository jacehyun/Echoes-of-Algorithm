[node name="ContentLabel" type="RichTextLabel" parent="CanvasLayer/InfoPanel2/Panel" unique_id=1164752432]
layout_mode = 0
offset_left = 50.0
offset_top = 142.0
offset_right = 524.0
offset_bottom = 360.0
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_constants/line_separation = 20
theme_override_fonts/normal_font = ExtResource("8_yr2l2")
theme_override_fonts/bold_font = ExtResource("8_yr2l2")
theme_override_font_sizes/normal_font_size = 12
theme_override_font_sizes/bold_font_size = 10
bbcode_enabled = true
text = "Machine Learning is generally categorized into three main types based on how the system is trained. Study these carefully before proceeding!

1. Supervised Learning
This type of learning trains a model using labeled data. This means both the input data and the correct output are already provided during training. The system learns by matching the inputs to the correct answers.

2. Unsupervised Learning
Unlike supervised learning, this method discovers hidden patterns without labeled data. The system explores the data entirely on its own to find structures or groups without knowing the correct answers beforehand.

3. Reinforcement Learning
This type of learning allows a system to learn through rewards and punishments based on its actions. It figures out the best way to achieve a goal by receiving rewards for correct moves and penalties for mistakes—very similar to training a character in a video game!"

